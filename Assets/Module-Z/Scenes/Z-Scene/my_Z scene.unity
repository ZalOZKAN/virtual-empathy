  m_Script: {fileID: 11500000, guid: ed11ffad10b49e5419616108399732f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChatBotController
  botMessageText: {fileID: 619827402}
  answerText: {fileID: 301965037}
  inputField: {fileID: 971096413}
  moduleMenuPanel: {fileID: 0}
  botVoice: {fileID: 1261887257}
  botMessageClip: {fileID: 8300000, guid: f6480638d03366549a865babe759a72e, type: 3}
  presetQAs:
  - question: "Bu ki\u015Fi neden 'iyiyim' dedi?"
    answer: "Bu ki\u015Fi neden 'iyiyim' dedi?\tBazen insanlar ger\xE7ek durumlar\u0131n\u0131
      anlatmak yerine k\u0131sa ve g\xFCvenli cevaplar verir. Bu kabal\u0131k de\u011Fil,
      korunma i\xE7g\xFCd\xFCs\xFCd\xFCr."
  - question: "Toplant\u0131da neden odaklanamad\u0131?"
    answer: "Toplant\u0131da neden odaklanamad\u0131?\tZihinsel y\xFCk alt\u0131ndaki
      biri d\u0131\u015Far\u0131dan dinliyormu\u015F gibi g\xF6r\xFCnse de i\xE7inde
      ba\u015Fka konular d\xF6n\xFCyor olabilir. Bu umursamazl\u0131k de\u011Fildir."
  - question: "B\xF6yle birine nas\u0131l yakla\u015Fmak gerekir?"
    answer: "Bask\u0131 yapmadan, yarg\u0131lamadan yakla\u015F. 'Nas\u0131ls\u0131n?'
      sorusunu sormak i\xE7in de\u011Fil, cevab\u0131n\u0131 ger\xE7ekten duymak
      i\xE7in sor."
  - question: "Bu davran\u0131\u015Flar\u0131n alt\u0131nda ne olabilir?"
    answer: "Bu davran\u0131\u015Flar\u0131n alt\u0131nda ne olabilir?\tSosyal kayg\u0131,
      zihinsel yorgunluk, duygusal y\xFCk veya d\u0131\u015Far\u0131ya yans\u0131t\u0131lmayan
      bir bask\u0131 olabilir. Her biri farkl\u0131 ama hepsi ger\xE7ek."
