  m_Script: {fileID: 11500000, guid: 63d80a06dd6b3dc43af9efc33f14c605, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  questions:
  - questionText: "K\u0131sa cevap her zaman ne de\u011Fildir?"
    options:
    - "Kabal\u0131k"
    - "\u0130lgisizlik"
    - "Umursamazl\u0131k"
    correctIndex: 0
    explanation: "Explanation: Arkas\u0131nda g\xF6r\xFCnmeyen bir y\xFCk olabilir\n"
  - questionText: "Toplant\u0131da dalg\u0131n biri i\xE7in ne d\xFC\u015F\xFCnmeliyiz?"
    options:
    - "Umursam\u0131yor "
    - "Zihinsel y\xFCk ta\u015F\u0131yor olabilir"
    - Dinlemek istemiyor
    correctIndex: 1
    explanation: "Dalg\u0131nl\u0131k umursamazl\u0131k de\u011Fildir"
  - questionText: "Sessiz kalan biri i\xE7in ilk tepkin ne olmal\u0131?"
    options:
    - "\u0130lgisiz biri"
    - Kaba biri
    - "Empatiyle yakla\u015F"
    correctIndex: 2
    explanation: "Sessizlik ilgisizlik de\u011Fildir"
  - questionText: "Sonder kavram\u0131 neyi ifade eder?"
    options:
    - "Herkesin derin bir i\xE7 d\xFCnyas\u0131 oldu\u011Funu fark etmek"
    - "Yabanc\u0131lardan uzak durmak"
    - "Empati kurmay\u0131 reddetmek"
    correctIndex: 0
    explanation: "Kar\u015F\u0131dan ge\xE7en herkesin karma\u015F\u0131k bir hayat\u0131
      var"
  - questionText: "G\xF6r\xFCnmeyen y\xFCk ne demektir?"
    options:
    - Fiziksel yorgunluk
    - "D\u0131\u015Far\u0131ya belli etmeden ta\u015F\u0131nan duygusal y\xFCk"
    - "\xC7evreye kar\u015F\u0131 ilgisizlik"
    correctIndex: 1
    explanation: "D\u0131\u015Far\u0131dan normal g\xF6r\xFCn\xFCp i\xE7ten zorlanmak"
  questionDisplay: {fileID: 1254646527}
  optionButtons:
  - {fileID: 192211884}
  - {fileID: 125184903}
  - {fileID: 1165068721}
  feedbackText: {fileID: 235501414}
